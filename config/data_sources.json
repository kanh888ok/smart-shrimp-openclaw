{
  "weather_api": {
    "enabled": true,
    "source": "openweather",
    "api_key": "YOUR_API_KEY_HERE",
    "location": {
      "name": "杭州",
      "lat": 30.27,
      "lon": 120.16,
      "timezone": "Asia/Shanghai"
    },
