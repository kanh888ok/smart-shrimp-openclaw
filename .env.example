# 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ==================== Streamlit 配置 ====================

# Streamlit 服务器端口
STREAMLIT_SERVER_PORT=8501

# Streamlit 服务器地址
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Streamlit 开发模式（生产环境设为 false）
STREAMLIT_DEVELOPMENT_MODE=false

# ==================== 应用配置 ====================

# 数据目录
DATA_DIR=data

# 报告目录
REPORTS_DIR=reports

# 日志目录
LOG_DIR=logs

# ==================== 模型配置 ====================

# Random Forest 随机种子
MODEL_RANDOM_SEED=42

# Random Forest 估计器数量
MODEL_N_ESTIMATORS=100

# Random Forest 最大深度
MODEL_MAX_DEPTH=10

# ==================== 分析配置 ====================

# FCR 阈值（优秀水平）
ANALYSIS_FCR_THRESHOLD=1.5

# SGR 阈值（优秀水平，百分比）
ANALYSIS_SGR_THRESHOLD=3.0

# 环境压力预警阈值
ANALYSIS_STRESS_THRESHOLD=3

# ==================== 日志配置 ====================

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# 是否输出到控制台
LOG_CONSOLE=true

# ==================== Docker 配置 ====================

# Docker 镜像名称
DOCKER_IMAGE_NAME=shrimp-farming-dashboard

# Docker 容器名称
DOCKER_CONTAINER_NAME=shrimp-farming-app

# Docker 网络名称
DOCKER_NETWORK_NAME=shrimp-farming-network
